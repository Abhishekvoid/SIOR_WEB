# SIOR Web Frontend Configuration Template

# App URL & Environment
NEXT_PUBLIC_APP_URL=https://sior-web.vercel.app
NODE_ENV=production

# SIOR Assistant Backend Connection (Optional - for connecting to local or remote SIOR agent)
NEXT_PUBLIC_SIOR_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SIOR_WS_URL=ws://127.0.0.1:8000/ws

# Simulation Mode (true = runs self-contained interactive simulated demos and telemetry)
NEXT_PUBLIC_ENABLE_SIMULATION=true

# External Service Keys (Optional - only needed if making direct calls to AI providers)
# SARVAM_API_KEY=your_sarvam_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
